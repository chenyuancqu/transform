{
  "name": "digital-twin-logistics",
  "version": "1.0.0",
  "description": "智联蜂群 - 移动母车与无人机协同智能取货系统数字孪生",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "demo": "powershell -ExecutionPolicy Bypass -File scripts/start-demo.ps1",
    "demo:stop": "powershell -ExecutionPolicy Bypass -File scripts/start-demo.ps1 -Stop",
    "test:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-backend.ps1",
    "test:integration": "node tests/v2-mqtt-integration.mjs",
    "test:integration:legacy": "node tests/mqtt-integration.mjs",
    "test:assets": "node --test tests/optimized-assets.test.mjs",
    "assets:optimize": "node scripts/optimize-campus-assets.mjs office dispatch matrice-300 mother && node scripts/prepare-rounded-nature.mjs && node scripts/prepare-tech-context.mjs"
  },
  "keywords": [
    "multi-agent",
    "reinforcement-learning",
    "digital-twin",
    "logistics"
  ],
  "author": "陈远、王维",
  "license": "ISC",
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "aedes": "^1.2.0",
    "mqtt": "^5.16.0",
    "onnxruntime-web": "^1.20.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "stats.js": "^0.17.0",
    "three": "^0.186.1",
    "vite": "^6.0.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "meshoptimizer": "^1.3.0"
  }
}
